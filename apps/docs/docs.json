{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "shugo",
  "logo": {
    "dark": "/apps/docs/images/Shugo(1)(1).png",
    "light": "/apps/docs/images/Shugo(2)(1).png"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#FFFFFF",
    "light": "#000000",
    "dark": "#FFFFFF"
  },
  "topbarLinks": [
    {
      "name": "GitHub",
      "url": "https://github.com/shugo-protocol/shugo"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "pages": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "quickstart",
              "architecture"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "velocity-caps",
              "velocity-caps-and-limits",
              "security"
            ]
          },
          {
            "group": "reference",
            "pages": [
              "sdk-reference",
              "cli-reference"
            ]
          },
          "faq"
        ]
      },
      {
        "tab": "Changelog",
        "pages": [
          "changelog"
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/Shugo-protocol"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Shugo-protocol",
      "website": "https://www.shugo.website",
      "x": "https://x.com/ShugoProtocol"
    }
  },
  "icons": {
    "library": "tabler"
  },
  "background": {
    "decoration": "gradient"
  },
  "appearance": {
    "default": "light"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "metadata": {
    "timestamp": false
  }
}
